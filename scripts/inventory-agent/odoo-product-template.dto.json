{
  "model": "product.template",
  "version": 1,
  "description": "Safe DTO contract for Galantes inventory publication. Production-specific custom fields must be refreshed with odoo:fields-export before enabling writes.",
  "requiredForCreate": [
    "name",
    "list_price",
    "type",
    "sale_ok",
    "purchase_ok"
  ],
  "requiredUserApproval": [
    "list_price",
    "standard_price",
    "qty_available"
  ],
  "writeAllowlist": [
    "name",
    "default_code",
    "barcode",
    "type",
    "sale_ok",
    "purchase_ok",
    "is_published",
    "available_in_pos",
    "website_published",
    "website_sequence",
    "public_categ_ids",
    "categ_id",
    "list_price",
    "standard_price",
    "taxes_id",
    "supplier_taxes_id",
    "description",
    "description_sale",
    "description_purchase",
    "website_description",
    "image_1920",
    "attribute_line_ids",
    "optional_product_ids",
    "accessory_product_ids",
    "alternative_product_ids",
    "invoice_policy",
    "uom_id",
    "uom_po_id",
    "tracking",
    "responsible_id",
    "route_ids",
    "sale_delay",
    "weight",
    "volume"
  ],
  "readonlyOrComputed": [
    "id",
    "display_name",
    "create_uid",
    "create_date",
    "write_uid",
    "write_date",
    "__last_update",
    "qty_available",
    "virtual_available",
    "free_qty",
    "incoming_qty",
    "outgoing_qty",
    "product_variant_id",
    "product_variant_ids",
    "product_variant_count",
    "currency_id",
    "company_id"
  ],
  "fields": {
    "id": { "type": "integer", "readonly": true },
    "name": { "type": "char", "required": true },
    "display_name": { "type": "char", "readonly": true },
    "default_code": { "type": "char" },
    "barcode": { "type": "char" },
    "type": { "type": "selection", "default": "consu" },
    "sale_ok": { "type": "boolean", "default": true },
    "purchase_ok": { "type": "boolean", "default": false },
    "is_published": { "type": "boolean", "default": false },
    "website_published": { "type": "boolean", "default": false },
    "available_in_pos": { "type": "boolean", "default": false },
    "website_sequence": { "type": "integer" },
    "public_categ_ids": { "type": "many2many", "relation": "product.public.category" },
    "categ_id": { "type": "many2one", "relation": "product.category" },
    "list_price": { "type": "float", "requiresUserApproval": true },
    "standard_price": { "type": "float", "requiresUserApproval": true },
    "taxes_id": { "type": "many2many", "relation": "account.tax" },
    "supplier_taxes_id": { "type": "many2many", "relation": "account.tax" },
    "description": { "type": "html" },
    "description_sale": { "type": "text" },
    "description_purchase": { "type": "text" },
    "website_description": { "type": "html" },
    "image_1920": { "type": "binary" },
    "attribute_line_ids": { "type": "one2many", "relation": "product.template.attribute.line" },
    "optional_product_ids": { "type": "many2many", "relation": "product.template" },
    "accessory_product_ids": { "type": "many2many", "relation": "product.product" },
    "alternative_product_ids": { "type": "many2many", "relation": "product.template" },
    "invoice_policy": { "type": "selection" },
    "uom_id": { "type": "many2one", "relation": "uom.uom" },
    "uom_po_id": { "type": "many2one", "relation": "uom.uom" },
    "tracking": { "type": "selection" },
    "responsible_id": { "type": "many2one", "relation": "res.users" },
    "route_ids": { "type": "many2many", "relation": "stock.route" },
    "sale_delay": { "type": "float" },
    "weight": { "type": "float" },
    "volume": { "type": "float" },
    "qty_available": { "type": "float", "readonly": true, "requiresUserApproval": true },
    "virtual_available": { "type": "float", "readonly": true },
    "free_qty": { "type": "float", "readonly": true },
    "incoming_qty": { "type": "float", "readonly": true },
    "outgoing_qty": { "type": "float", "readonly": true },
    "product_variant_id": { "type": "many2one", "relation": "product.product", "readonly": true },
    "product_variant_ids": { "type": "one2many", "relation": "product.product", "readonly": true },
    "product_variant_count": { "type": "integer", "readonly": true },
    "currency_id": { "type": "many2one", "relation": "res.currency", "readonly": true },
    "company_id": { "type": "many2one", "relation": "res.company", "readonly": true },
    "create_uid": { "type": "many2one", "relation": "res.users", "readonly": true },
    "create_date": { "type": "datetime", "readonly": true },
    "write_uid": { "type": "many2one", "relation": "res.users", "readonly": true },
    "write_date": { "type": "datetime", "readonly": true },
    "__last_update": { "type": "datetime", "readonly": true }
  }
}
