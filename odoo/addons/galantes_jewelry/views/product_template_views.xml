<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extend product.template form view with full storefront governance -->
    <record id="product_template_form_view_galantes" model="ir.ui.view">
        <field name="name">product.template.form (galantes_jewelry)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button type="action"
                        name="%(galantes_jewelry.product_gallery_upload_wizard_action)d"
                        class="oe_stat_button"
                        icon="fa-upload">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="gallery_ids_count" nolabel="1" readonly="1"/>
                        </span>
                        <span class="o_stat_text">Add photos</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Storefront" name="jewelry_storefront">
                    <!-- Publication & Merchandising -->
                    <group string="Publication &amp; Merchandising">
                        <field name="available_on_website"/>
                        <field name="is_featured"/>
                        <field name="sequence"/>
                        <field name="material"/>
                        <field name="availability_status" readonly="1"/>
                    </group>

                    <group string="Additional Photos">
                        <label for="gallery_ids" string="Product gallery"/>
                        <div class="text-muted" style="margin-bottom: 8px;">
                            Add multiple photos of the same product here. Use the button above if you prefer the full upload dialog.
                        </div>
                        <field name="gallery_ids">
                            <list editable="bottom" default_order="sequence,id">
                                <field name="sequence" widget="handle"/>
                                <field name="active"/>
                                <field name="image" widget="image" options="{'preview_image': 'image'}"/>
                                <field name="name"/>
                                <field name="alt_text"/>
                            </list>
                            <form string="Gallery Image">
                                <sheet>
                                    <group>
                                        <field name="product_id" invisible="1"/>
                                        <field name="image" widget="image"/>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="alt_text"/>
                                        <field name="active"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>

                    <!-- URL / SEO -->
                    <group string="URL &amp; SEO">
                        <field name="slug"
                               help="Auto-generated from the product name. Customize to fix the storefront URL."/>
                        <field name="buy_url" readonly="1"
                               help="Storefront URL: https://shop.galantesjewelry.com/shop/&lt;slug&gt;"/>
                    </group>

                    <!-- Storefront copy -->
                    <group string="Storefront Copy (English only - shown to customers)">
                        <field name="tagline"
                               placeholder="e.g. Handcrafted in 14K gold with a timeless silhouette"
                               help="One-line value proposition shown on product cards (max ~100 chars)"/>
                        <field name="storefront_short_description" widget="text"
                               placeholder="1–3 sentences. Persuasive, concise, customer-safe. No internal notes."
                               help="Shown on product cards and listing previews"/>
                        <field name="storefront_long_description" widget="text"
                               placeholder="Full product story for the detail page. Focus on craftsmanship and value."
                               help="Displayed in the 'About This Piece' section on the detail page"/>
                        <field name="product_details" widget="text"
                               placeholder="Metal: 14K Yellow Gold&#10;Stone: 0.25ct Round Diamond&#10;Length: 18 inches&#10;Clasp: Lobster claw"
                               help="Key specifications shown in the 'Product Details' section"/>
                        <field name="care_and_shipping" widget="text"
                               placeholder="Store in the provided jewelry box away from moisture.&#10;Complimentary gift packaging included.&#10;Free US shipping on orders over $200."
                               help="Shown in the 'Shipping &amp; Care' section on the detail page"/>
                    </group>

                </page>
            </xpath>
        </field>
    </record>

    <!-- Product template tree view – add material and availability columns -->
    <record id="product_template_tree_view_galantes" model="ir.ui.view">
        <field name="name">product.template.tree (galantes_jewelry)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="material"/>
                <field name="is_featured" string="Featured"/>
                <field name="available_on_website" string="On Website"/>
                <field name="availability_status" string="Stock"/>
            </xpath>
        </field>
    </record>

</odoo>
