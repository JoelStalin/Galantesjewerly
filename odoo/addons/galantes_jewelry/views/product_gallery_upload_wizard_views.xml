<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_gallery_upload_wizard_form" model="ir.ui.view">
        <field name="name">galantes.product.gallery.upload.wizard.form</field>
        <field name="model">galantes.product.gallery.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Add photos to product">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        Select multiple images at once or drag and drop them here. Saving will create all additional product photos in one batch.
                    </div>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               string="Images"
                               help="Drag and drop multiple images or select them in a single batch."/>
                    </group>
                    <div class="text-muted">
                        Tip: use JPG, PNG, or WEBP files for the best results.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Add photos" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_gallery_upload_wizard_action" model="ir.actions.act_window">
        <field name="name">Add photos</field>
        <field name="res_model">galantes.product.gallery.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
