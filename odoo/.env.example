# Local Odoo container environment.
# Copy to odoo/.env only for local development. Do not commit real values.

POSTGRES_DB=galantes_db
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
PGDATA=/var/lib/postgresql/data/pgdata
ODOO_RC=/etc/odoo/odoo.conf
ODOO_ADDONS_PATH=/mnt/enterprise-addons,/mnt/extra-addons
